            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My test post\",\n  \"content\": \"This is a test post created through Postman.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Post is returned\", function () {",
                  "    pm.expect(json).to.have.property(\"post\");",
                  "});",
                  "",
                  "if (json.post && json.post.id) {",
                  "    pm.collectionVariables.set(\"postId\", json.post.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Post - XSS Test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"<script>alert('XSS')</script>\",\n  \"content\": \"<img src=x onerror=alert(1)>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"XSS payload is escaped\", function () {",
                  "    pm.expect(json.post.title).to.not.include(\"<script>\");",
                  "    pm.expect(json.post.content).to.not.include(\"<img\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
